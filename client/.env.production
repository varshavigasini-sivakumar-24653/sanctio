# Read by Vite at build time only (client/src/lib/api.js). The deployed Slate app
# (onslate.in) and the BFF function (catalystserverless.in) are different origins,
# so the client needs the function's absolute invoke URL here instead of the
# relative /api path that vite.config.js's dev-only proxy resolves locally.
VITE_API_BASE=https://sanctio-60083985672.development.catalystserverless.in/server/sanctio_api/api
