# Zoho OAuth — self-client credentials.
#
# IMPORTANT: issue these on the INDIA console (api-console.zoho.in), not .com.
# The Projects portal lives on projects.zoho.in; a .com token authenticates but
# every API call 401s.
#
# Required scopes:
#   ZohoProjects.portals.READ
#   ZohoProjects.projects.ALL
#   ZohoProjects.tasks.ALL
#   ZohoProjects.milestones.ALL
#   ZohoProjects.timesheets.ALL
#   ZohoProjects.bugs.ALL
#   ZohoProjects.search.READ
#   ZohoProjects.settings.ALL
#   ZohoProjects.customentity.ALL
#   ZohoPC.files.ALL

ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Verified via MCP — the Sanctio portal.
ZOHO_PORTAL_ID=60083699064
ZOHO_ACCOUNTS_HOST=https://accounts.zoho.in
ZOHO_API_BASE=https://projects.zoho.in/api/v3
